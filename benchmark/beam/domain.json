    "LOCATED_IN": {"source_types": ["Organization", "Project", "Artifact"], "target_types": ["Place", "Organization"], "labels": ["located in", "hosted by", "owned by"]},
    "WORKS_ON": {"source_types": ["Identity", "Organization"], "target_types": ["Project", "Artifact"], "labels": ["works on", "maintains", "develops", "contributes to"]},
    "PART_OF": {"source_types": ["Project", "Artifact", "Activity"], "target_types": ["Organization", "Project", "Activity"], "labels": ["part of", "component of", "depends on"]},
    "LIKES": {"source_types": ["Identity"], "target_types": ["Activity", "Artifact", "Place", "Concept"], "labels": ["likes", "enjoys", "prefers"]},
    "ATTENDED": {"source_types": ["Identity"], "target_types": ["Event", "Place"], "labels": ["attended", "visited", "went to"]}
