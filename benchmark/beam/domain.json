    "Event": {"topic": "Personal", "allowed_topics": ["Personal", "Work"], "labels": ["event", "meeting", "trip", "release", "deadline"]},
    "Activity": {"topic": "Interests", "allowed_topics": ["Interests", "Work", "Personal", "Technical"], "labels": ["hobby", "sport", "activity", "workflow", "practice"]},
    "Concept": {"topic": "General", "allowed_topics": ["General", "Technical"], "labels": ["concept", "decision", "preference", "goal", "plan", "requirement", "issue"]},
