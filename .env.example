# ===========================================
# Knoggin Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# -------------------------------------------
# Optional - defaults shown
# -------------------------------------------

# PostgreSQL data store (only change if running outside Docker)
DATABASE_URL=postgresql://knoggin:knoggin@localhost:5432/knoggin_db

# Stable application-managed settings directory. The API resolves this path
# before starting the engine.
SETTINGS_DIR=~/.config/knoggin

# One local identity is bound when the API process starts.
RUNTIME_USER_NAME=local

# Prefer GPU for local models when CUDA or MPS is available; otherwise use CPU.
PREFER_GPU=false

# Local embedding and reranker models. Their dimensions must match the
# canonical pgvector schema in server/src/infrastructure/schema.sql.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BACKEND=onnx
RERANKER_MODEL=BAAI/bge-reranker-base

# Thread pool workers (increase if you have more CPU cores)
THREAD_WORKERS=4

# Explicit local resource budget: conservative, balanced, or performance.
# Individual worker/batch settings override the selected profile.
RESOURCE_PROFILE=balanced

# OpenRouter API key used by the private JEV identity/classification pilot runners.
# Leave blank unless you are running a reviewed JEV evaluation.
OPENROUTER_API_KEY=

# ONNX execution provider: auto chooses the best installed provider for the
# current runtime, or set CPUExecutionProvider/CUDAExecutionProvider/etc.
ONNX_PROVIDER=auto

# LLM, search-provider, document, and agent settings are stored in the managed
# knoggin.yml file under SETTINGS_DIR.
