# ===========================================
# Knoggin Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# -------------------------------------------
# Optional - defaults shown
# -------------------------------------------

# Data store hosts (only change if running outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_URL=postgresql://knoggin:knoggin@localhost:5432/knoggin_db

# Managed storage root for original uploaded project files
KNOGGIN_DOCUMENT_STORAGE_DIR=./data/documents

# GPU acceleration
# Set to "true" to enable GPU for embeddings and NER
KNOGGIN_GPU=false

# Local embedding model. The default Stella ONNX export is loaded directly
# from the Hugging Face cache when it exposes pooled sentence embeddings.
KNOGGIN_EMBEDDING_MODEL=dunzhang/stella_en_1.5B_v5
KNOGGIN_EMBEDDING_BACKEND=onnx
KNOGGIN_RERANKER_MODEL=BAAI/bge-reranker-large

# Thread pool workers (increase if you have more CPU cores)
KNOGGIN_WORKERS=4

# Explicit local resource budget: conservative, balanced, or performance.
# Individual KNOGGIN_* worker/batch settings override the selected profile.
KNOGGIN_RESOURCE_PROFILE=balanced

# ONNX execution provider: auto chooses the best installed provider for the
# current runtime, or set CPUExecutionProvider/CUDAExecutionProvider/etc.
KNOGGIN_ONNX_PROVIDER=auto

# Document-search cross-encoder reranking. It lazy-loads on the first search
# that needs it, then reranks this many hybrid candidates.
KNOGGIN_DOCUMENT_RERANK_ENABLED=true
KNOGGIN_DOCUMENT_RERANK_CANDIDATES=15

# Note: LLM API keys, model selection, and user name 
# are configured through the app's onboarding UI,
# not through environment variables.
